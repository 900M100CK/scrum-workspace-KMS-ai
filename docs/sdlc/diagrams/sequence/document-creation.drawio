<mxCell id="msg-24" value="Reconcile or retry same persistence identity and immutable payload" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="2960" as="sourcePoint"/><mxPoint x="1430" y="2960" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-25" value="Confirmed original result or still unknown" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="3060" as="sourcePoint"/><mxPoint x="610" y="3060" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-26" value="Confirmed authorised response or pending; no duplicate version/grant" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="3160" as="sourcePoint"/><mxPoint x="200" y="3160" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="note-27" value="Safe default: retain inaccessible orphan policy. Cleanup needs durable cancellation/fencing proving delayed persistence cannot commit. This protocol is an explicit design gap, not an age-based sweep." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="3260" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="note-28" value="No Workspace activation step. Unknown remote lifecycle-write outcomes block affected protected handoffs until reconciliation. Indexing can fail independently; committed permitted keyword content does not depend on embeddings." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="3525" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="diagram-title" value="DGM-SEQ-02 v0.1 Draft | Workspace-first document creation and uncertain outcomes | 18 October 2026 | Sources: DGM-DESIGN-01 v0.1; PRD-01 v0.9; UC-02 v0.8; SAD-03 v0.16; DATA-04 v0.13; ADR-0007; ADR-0009; ADR-0011; ADR-0012; ADR-0017" vertex="1" parent="1" style="text;align=left;fontStyle=1;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="30" y="15" width="2090" height="105" as="geometry"/></mxCell>
<mxCell id="diagram-scope" value="Cross-service protocol using existing operation identities. No distributed transaction, activation endpoint or orphan-age deletion.&lt;br/&gt;Each service commits only its own database. Same actor/key/payload binds one stable document identity. Handler implementation pending." vertex="1" parent="1" style="text;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="30" y="125" width="2090" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
