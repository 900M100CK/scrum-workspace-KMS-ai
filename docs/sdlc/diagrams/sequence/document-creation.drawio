<mxCell id="msg-22" value="Resolve original binding; do not allocate another ID or restore revoked grants" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="2760" as="sourcePoint"/><mxPoint x="1020" y="2760" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
