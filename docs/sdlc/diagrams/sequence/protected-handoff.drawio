<mxCell id="msg-8" value="Outside guard: authenticated getHandoffManifest by exact handoff ID" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1290" as="sourcePoint"/><mxPoint x="200" y="1290" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-9" value="Exact committed manifest bytes/digest/receipt; unknown or mismatch sends zero&lt;br/&gt;bytes" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1390" as="sourcePoint"/><mxPoint x="1020" y="1390" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-10" value="Durably claim handoff ID once, bound to actor and manifest digest" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1490" as="sourcePoint"/><mxPoint x="1430" y="1490" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="branch-11" value="alt [Existing / unknown claim or claim storage failure]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="1590" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-12" value="No fresh claimant" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="1705" as="sourcePoint"/><mxPoint x="1020" y="1705" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="note-13" value="STOP: no send; consumed/unresolved identities cannot expire into replay. Restart/abort fences the old claimant." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="1805" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="branch-14" value="else [Fresh claim durably acknowledged]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="1935" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-15" value="Exclusive fresh claimant" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="2050" as="sourcePoint"/><mxPoint x="1020" y="2050" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-16" value="Acquire applicable project/session guard" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="2150" as="sourcePoint"/><mxPoint x="1020" y="2195" as="targetPoint"/><mxPoint as="offset" x="0" y="-48"/><Array as="points"><mxPoint x="1115" y="2150"/><mxPoint x="1115" y="2195"/></Array></mxGeometry></mxCell>
<mxCell id="msg-17" value="In-process current session, membership and document authority check" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="2270" as="sourcePoint"/><mxPoint x="1020" y="2315" as="targetPoint"/><mxPoint as="offset" x="0" y="-48"/><Array as="points"><mxPoint x="1115" y="2270"/><mxPoint x="1115" y="2315"/></Array></mxGeometry></mxCell>
<mxCell id="msg-18" value="Authenticated scoped final evidence/version/availability validation; no&lt;br/&gt;recursive guard" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="2390" as="sourcePoint"/><mxPoint x="200" y="2390" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-19" value="Match complete mixed document/operational evidence, current revisions and&lt;br/&gt;exact receipt/byte binding" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="2490" as="sourcePoint"/><mxPoint x="1020" y="2490" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="note-20" value="Final check includes operational entity kind/ID/revision/time and payload digest. No cached grant or changed payload may pass. Concurrent revocation waits if this handoff already holds the same guard." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="2590" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="branch-21" value="alt [Denied / changed evidence, digest mismatch, unknown authority or lifecycle outcome]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="2720" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-22" value="Zero protected bytes; withhold entire original draft; release guard" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="2835" as="sourcePoint"/><mxPoint x="1020" y="2880" as="targetPoint"/><mxPoint as="offset" x="0" y="-48"/><Array as="points"><mxPoint x="1115" y="2835"/><mxPoint x="1115" y="2880"/></Array></mxGeometry></mxCell>
<mxCell id="note-23" value="Outside guard: only eligible pre-send failures may start a bounded fresh preparation. Revoked-answer replacement requires new generation/support checks; exhausted budget yields generic failure." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="2955" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="branch-24" value="else [Exact, permitted, complete match]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="3085" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-25" value="Hand off frozen bytes while guard remains held" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="3200" as="sourcePoint"/><mxPoint x="1840" y="3200" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="branch-26" value="alt [Transport completion known]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="3300" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-27" value="Transport completed (not proof of downstream rendering)" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="1840" y="3415" as="sourcePoint"/><mxPoint x="1020" y="3415" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-28" value="Release guard after completion" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="3515" as="sourcePoint"/><mxPoint x="1020" y="3560" as="targetPoint"/><mxPoint as="offset" x="0" y="-48"/><Array as="points"><mxPoint x="1115" y="3515"/><mxPoint x="1115" y="3560"/></Array></mxGeometry></mxCell>
<mxCell id="branch-29" value="else [Timeout / crash / unknown transport]" vertex="1" parent="1" style="text;fillColor=#f1f5f9;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="65" y="3635" width="2020" height="48" as="geometry"/></mxCell>
<mxCell id="msg-30" value="Confirm abort and fence attempt, or retain unknown/quarantine affected&lt;br/&gt;handoffs until reconciled" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="3750" as="sourcePoint"/><mxPoint x="1020" y="3795" as="targetPoint"/><mxPoint as="offset" x="0" y="-48"/><Array as="points"><mxPoint x="1115" y="3750"/><mxPoint x="1115" y="3795"/></Array></mxGeometry></mxCell>
<mxCell id="note-31" value="No automatic replay and no automatic fresh-identity resend after unknown transport. An aborted claimant cannot resume. Exactly-once external delivery is not promised." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="3870" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="msg-34" value="Retain claim and known/aborted/unknown relay outcome; never recycle identity" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="4090" as="sourcePoint"/><mxPoint x="1430" y="4090" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-35" value="Report correlated outcome outside guard when communication is available" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="4190" as="sourcePoint"/><mxPoint x="200" y="4190" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="msg-36" value="Append HandoffOutcome; never mutate prepared manifest" edge="1" parent="1" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="4290" as="sourcePoint"/><mxPoint x="610" y="4290" as="targetPoint"/><mxPoint as="offset" x="0" y="-30"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="note-35" value="Revocation commits under the same guard after prior handoff completion/confirmed abort, then acknowledges success. Unknown remote lifecycle writes block affected handoffs. Already sent bytes cannot be recalled; a crash can leave outcome reconciliation pending." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="4390" width="1980" height="70" as="geometry"/></mxCell>
<mxCell id="diagram-title" value="DGM-SEQ-01 v0.2 Draft | Protected handoff, one-use claim and revocation | 18 October 2026 | Sources: DGM-DESIGN-01 v0.1; PRD-01 v0.10.2; UC-02 v0.8.3; SAD-03 v0.19.1; DATA-04 v0.16.3; ADR-0006; ADR-0011; ADR-0012; ADR-0013; ADR-0017; ADR-0020" vertex="1" parent="1" style="text;align=left;fontStyle=1;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="30" y="15" width="2090" height="105" as="geometry"/></mxCell>
<mxCell id="diagram-scope" value="One provider-input OR answer-delivery attempt; repeat with a fresh manifest per purpose. Handlers and additive manifest storage are pending.&lt;br/&gt;Solid: call; dashed: return. Guard is Workspace-owned; durable preparation and remote outcome writes occur outside it." vertex="1" parent="1" style="text;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="30" y="125" width="2090" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
