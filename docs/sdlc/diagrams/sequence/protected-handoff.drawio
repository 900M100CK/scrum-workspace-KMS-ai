<mxCell id="note-4" value="STOP: send zero protected bytes. Reconcile the same preparation identity/digest outside any guard; no send on an unknown write." vertex="1" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="85" y="845" width="1980" height="70" as="geometry"/></mxCell>
