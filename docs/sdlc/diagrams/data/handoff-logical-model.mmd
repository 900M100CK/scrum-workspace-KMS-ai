%% Scope: Logical model additions and service-owned claim correlation. Dashed associations are logical, NOT database foreign keys.
%% Legend: HandoffManifest/Outcome need additive migration. Workspace claim maps to existing idempotency_record, not a new chosen table. Physical-purge locator tombstone design remains open.
erDiagram
    Execution {
        uuid run_id PK
        uuid actor_id
        uuid project_id
    }
    HandoffManifest {
        uuid handoff_id PK
        uuid run_id
        uuid attempt_id
        text purpose
        uuid actor_id
        uuid project_id
        text access_context_ref
        json evidence_set
        json revision_refs
        text payload_digest
        text manifest_digest
        boolean complete
    }
    HandoffOutcome {
        uuid outcome_id PK
        uuid handoff_id
        text status "prepared completed aborted unknown"
        timestamptz observed_at
        text enforcement_ref
    }
    WorkspaceClaim {
        uuid actor_id PK
        text operation PK "protected_handoff"
        text idempotency_key PK "handoff_id"
        text payload_hash "manifest_digest binding"
        text state "existing schema; protocol pending"
    }
    Provenance {
        uuid run_id PK
        text source_id PK
        text entity_kind "additive gap"
        uuid entity_id
        bigint observation_revision
        timestamptz observed_at
    }
    Execution ||..o{ HandoffManifest : "Knowledge owns immutable complete evidence"
    HandoffManifest ||..o{ HandoffOutcome : "append-only observations; prepared proves no send"
    HandoffManifest ||..o| WorkspaceClaim : "contract ID/digest correlation only; no cross-store FK"
    Execution ||..o{ Provenance : "exact document tuple OR operational kind/ID/revision/time"
