<mxCell id="diagram-scope" value="Workspace schema through selected additive migration 009, tested only in disposable PostgreSQL; development upgrade not claimed. Selected fields; database storage is not end-user authority.&lt;br/&gt;Relationship label names FK columns; ||--o{ means parent 1 to child 0..many. AuthAccount is private authentication storage; no cross-store FK. Session/idempotency/authentication audit have no project FK." vertex="1" parent="1" style="text;align=left;whiteSpace=wrap;html=1;fontSize=16;spacing=12;"><mxGeometry x="30" y="125" width="5352" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
