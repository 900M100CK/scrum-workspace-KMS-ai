%% Sources: DGM-DESIGN-01 v0.1; PRD-01 v0.9; UC-02 v0.7; SAD-03 v0.15; DATA-04 v0.11; ADR-0004; ADR-0007; ADR-0008; ADR-0011; ADR-0012; ADR-0017; ADR-0018; ADR-0023
%% Trace: BR-01–BR-03, BR-06, BR-10–BR-12; SC-03/04/06
%% Scope: Schema through Workspace migration 004; development database upgrade not claimed. Selected columns; storage/service constraints are not end-user authority.
%% Legend: Relationship label names FK columns; ||--o{ means parent 1 to child 0..many. User IDs are opaque; no User table or cross-store FK. Session/idempotency have no project FK.
erDiagram
    project {
        uuid project_id PK
        text name
        bigint revision
        bigint backlog_revision "set and order generation"
    }
    membership {
        uuid project_id PK,FK
        uuid user_id PK
        boolean active
        bigint membership_generation
        text role
    }
    session {
        uuid session_id PK
        uuid user_id
        boolean revoked
        timestamptz expires_at
        bigint revision
    }
    sprint {
        uuid sprint_id PK
        uuid project_id FK
        text state "planned active completed"
        bigint revision
    }
    task {
        uuid task_id PK
        uuid project_id FK
        uuid assignee_id FK "nullable composite membership FK"
        text state "todo in_progress done"
        numeric backlog_position
        bigint revision
        text location_kind "backlog sprint completed"
        uuid location_sprint_id FK "nullable current pointer independent of history"
    }
    sprint_allocation {
        uuid sprint_id PK,FK
        uuid task_id PK,FK
        uuid project_id FK
        text allocation_state "allocated completed returned"
        bigint revision
    }
    blocker_event {
        uuid event_id PK
        uuid task_id FK
        bigint sequence "unique per task"
        text status "open resolved"
    }
    document_policy {
        uuid document_id PK
        uuid project_id FK
        text classification
        text registry_state "active unavailable after 002"
        bigint permission_revision
    }
    read_grant {
        uuid document_id PK,FK
        uuid user_id PK,FK
        bigint grant_generation PK
        uuid project_id FK
        bigint membership_generation
        boolean valid
    }
    capability_grant {
        uuid grant_id PK
        uuid project_id FK
        uuid subject_id
        uuid resource_id
        text action
        boolean valid
    }
    business_audit {
        uuid event_id PK
        uuid project_id FK
        uuid actor_id
        uuid entity_id
        uuid correlation_id
    }
    idempotency_record {
        uuid actor_id PK
        text operation PK
        text idempotency_key PK
        text payload_hash
        text state
        timestamptz expires_at
        uuid claim_fence "protected only"
        uuid process_ref "protected only"
    }
    protected_handoff_outcome {
        uuid outcome_id PK
        uuid actor_id FK
        text operation FK
        text handoff_id FK
        uuid claim_fence FK
        text status
        timestamptz observed_at
        text enforcement_ref
    }
    project ||--o{ membership : "project_id"
    project ||--o{ sprint : "project_id"
    project ||--o{ task : "project_id"
    membership o|--o{ task : "project_id + nullable assignee_id"
    sprint ||--o{ sprint_allocation : "project_id + sprint_id"
    task ||--o{ sprint_allocation : "project_id + task_id"
    task ||--o{ blocker_event : "task_id"
    project ||--o{ document_policy : "project_id"
    document_policy ||--o{ read_grant : "project_id + document_id"
    membership ||--o{ read_grant : "project_id + user_id"
    project ||--o{ capability_grant : "project_id"
    project ||--o{ business_audit : "project_id"
    sprint o|--o{ task : "project_id + location_sprint_id (deferred)"
    sprint_allocation o|--o| task : "location_sprint_id + task_id (deferred)"
    idempotency_record ||--o{ protected_handoff_outcome : "actor operation key fence; append-only"
