        uuid document_id PK,FK
        uuid version_id PK
        text state "current superseded archived after 002"
        text immutable_content
    }
    passage {
        uuid document_id PK,FK
        uuid version_id PK,FK
        uuid passage_id PK
        text immutable_excerpt
        text locator
    }
    embedding_configuration {
        uuid configuration_id PK
        text model_version
        int dimensions
        text distance_metric
    }
    search_job {
        uuid job_id PK
        uuid document_id FK
        uuid version_id FK
        uuid configuration_id FK
        bigint aggregate_revision
        bigint processing_generation
        text readiness
        boolean tombstone
    }
    passage_embedding {
        uuid document_id PK,FK
        uuid version_id PK,FK
        uuid passage_id PK,FK
        uuid configuration_id PK,FK
        uuid job_id FK
        int dimensions FK
        vector embedding
    }
    execution {
        uuid run_id PK
        uuid actor_id
        uuid project_id
        uuid configuration_id FK "nullable"
    }
    provenance {
        uuid run_id PK,FK
        text source_id PK
        uuid document_id FK "nullable exact tuple"
        uuid version_id FK
        uuid passage_id FK
        uuid entity_id "operational alternative"
        bigint observation_revision
        timestamptz observed_at
    }
    link {
        uuid link_id PK
        uuid project_id
        text from_kind
