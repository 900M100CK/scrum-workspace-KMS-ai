        text to_kind
        uuid to_id
        text relation
    }
    business_audit {
        uuid event_id PK
        uuid actor_id
        uuid project_id
        uuid entity_id
        uuid correlation_id
    }
    idempotency_record {
        uuid actor_id PK
        text operation PK
        text idempotency_key PK
        text state
        text payload_hash
        timestamptz expires_at
    }
    handoff_manifest {
        text handoff_id PK
        uuid run_id FK
        uuid actor_id FK
        uuid project_id FK
        jsonb manifest "full evidence"
        bytea manifest_bytes
        text manifest_digest "generated SHA256"
