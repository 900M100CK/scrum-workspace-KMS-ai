                </mxCell>
                <mxCell id="Insufficient" parent="1" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" value="Insufficient evidence; no hints about hidden sources; capability-aware Create action" vertex="1">
