<mxfile host="drawio"><diagram id="DGM-FLOW-01" name="ai-qa-flow"><mxGraphModel grid="1" page="1" pageWidth="1840" pageHeight="3580"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="diagram-title" value="DGM-FLOW-01 v0.3 Draft | ai-qa-flow | 12 October 2026 | PRD v0.4 / SAD v0.5; Proposed policies; rendering unverified" style="text;whiteSpace=wrap;html=0;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1720" height="90" as="geometry"/></mxCell>
<mxCell id="Start" value="User submits POST /knowledge/questions using application session" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Read" value="1. Workspace checks session and current project/document scope; Knowledge retrieves permitted evidence" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="400" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Scope" value="Current-only by default; explicit labelled history; no Draft; operational facts from current observations" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Enough" value="Evidence supports requested claim?" style="rhombus;fillColor=#fff2cc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="920" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Insufficient" value="Insufficient evidence; no hints about hidden sources; capability-aware Create action" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="1180" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Provider" value="2. Guarded current access + Knowledge validity check through provider-input transport handoff" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="1180" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Generate" value="Wait outside guard; buffer whole answer; no browser token streaming" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="1440" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Validate" value="Validate server-assigned exact citations and supported claims; surface accessible conflicts" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="1700" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Delivery" value="3. Guarded recheck of entire evidence set including uncited context, session and validity" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="1960" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Safe" value="All evidence remains permitted and valid?" style="rhombus;fillColor=#fff2cc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="2220" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Withhold" value="Withhold entire original draft; no answer content or source reason" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="2480" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Retry" value="Bounded new attempt with remaining permitted evidence; repeat all checks" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="1440" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Answer" value="Guard held through answer response handoff completion or abort; render confirmed answer/conflict" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="2480" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Click" value="User opens exact citation" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="2740" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Citation" value="4. GET /knowledge/citations/{document_id}/{version_id}/{passage_id}; guarded current protected read" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="3000" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Inspect" value="Exact excerpt and version; label Current / Superseded / Archived; no substitution" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="3260" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Unavailable" value="Specific Citation unavailable only if surviving identity is readable; OD-04 / API mapping open" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="3260" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Denied" value="401 sign-in or identical generic 404 for unknown/denied; withhold protected data" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="660" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Authority" value="Authority failure: fail closed; generic service error; no cached/unrestricted fallback" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="660" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="AIError" value="AI dependency error/timeout/budget: explicit failure, no generated answer" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="1700" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="Fallback" value="Keyword search and document/work UI when own dependencies healthy" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="1960" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="KnowledgeError" value="Knowledge service/storage outage: documents and keyword search unavailable; Workspace work may continue" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1340" y="660" width="360" height="170" as="geometry"/></mxCell>
