                <mxCell id="Read" parent="1" style="rounded=1;fillColor=#dae8fc;whiteSpace=wrap;html=0;fontSize=13;spacing=10;" value="1. Workspace checks session and current project/document scope; Knowledge retrieves permitted evidence" vertex="1">
