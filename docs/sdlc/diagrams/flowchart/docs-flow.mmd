%% Owner-confirmed direction; UI and runtime evidence pending. API keys are relative to /api.
flowchart TD
    Start["Authenticated member opens document workspace"]
    Scope["Server scopes list: project-shared or restricted with current read grant; no hidden metadata"]
    Action{"Choose operation"}
    Create["Create capability; explicit project-shared or restricted; POST /knowledge/documents"]
    Register["Workspace allocates identity, policy and author capabilities/read grant; Knowledge persists initial Current; no activation step"]
    Pending["202: creation pending; no completed accessible document"]
    Current["201: initial Current; independently fetch readiness"]
    Read["GET /knowledge/documents/{document_id}; shared protected-read checks"]
    Denied["401 sign-in; generic 404 unknown/denied; 503 unknown authority"]
    View["Show authorised version and validity"]
    Revise["Content-write check; edit unsaved form; POST /knowledge/documents/{document_id}/versions"]
    Saving["Saving UI; expected_revision and Idempotency-Key; guarded atomic Knowledge commit"]
    Saved["201 confirmed: new immutable Current, previous Superseded, pointer updated; exact old citations unchanged"]
    Conflict["409: refresh permitted aggregate; require fresh user decision"]
    Failure["Failure or uncertain result: reconcile; no blind retry; unknown lifecycle outcome blocks handoffs"]
    Ready["GET /knowledge/documents/{document_id}/versions/{version_id}/readiness"]
    Index["pending: Indexing; ready: Search ready; failed: Indexing failed; lifecycle separate"]
    History["Explicit history / exact citation: recheck permission; label Superseded or Archived; never substitute"]
    Manage["Scoped manage-access; independent of content read"]
    Policy["POST /documents/{document_id}/classification or /read-grants; DELETE /documents/{document_id}/read-grants/{user_id}"]
    Revoke["Guarded commit + audit; invalidate access/cache scope; recheck all protected handoffs"]
    Removal["Membership removal: block last manager; atomically revoke all individual grants, clear assignees and audit; rejoin restores neither"]
    Retire["Lifecycle capability + confirmation; POST /knowledge/documents/{document_id}/versions/{version_id}/archive or DELETE /knowledge/documents/{document_id}"]
    Retired["Archive excludes ordinary retrieval; delete stops active access; stale jobs cannot revive; exact citation rules apply"]
    Start --> Scope
    Scope --> Action
    Action -->|Create| Create
    Create --> Register
    Create -->|Rejected| Denied
    Register -->|Partial| Pending
    Register -->|Confirmed| Current
    Current --> Ready
    Action -->|Open| Read
    Read -->|Failed check| Denied
    Read -->|Permitted| View
    View -->|Revise| Revise
    Revise --> Saving
    Saving -->|Rejected| Denied
    Saving -->|201| Saved
    Saving -->|409| Conflict
    Saving -->|503 or lost response| Failure
    Saved --> Ready
    Ready -->|200| Index
    Ready -->|Check failed| Denied
    View -->|History / citation| History
    Action -->|Manage access| Manage
    Manage -->|Permitted| Policy
    Manage -->|Denied| Denied
    Policy -->|Committed| Revoke
    Policy -->|409| Conflict
    Policy -->|Error| Failure
    Removal --> Revoke
    View -->|Archive / delete| Retire
    Retire -->|Confirmed| Retired
    Retire -->|409| Conflict
    Retire -->|Unknown / error| Failure
    Retire -->|Rejected| Denied
    Saved -->|Revise again: new Current| Revise
