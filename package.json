{
  "name": "scrum-workspace-kms-context",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "commits:setup": "node scripts/commit-message.mjs --install",
    "db:init": "node scripts/database.mjs init",
    "db:up": "node scripts/database.mjs up",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:rollback": "node scripts/database.mjs rollback",
    "db:stop": "node scripts/database.mjs stop",
    "db:test": "node --test --test-concurrency=1 tests/storage.test.mjs tests/storage/handoff-storage.test.mjs",
    "context:check": "node scripts/verify-context.mjs",
    "context:lint": "node --check scripts/verify-context.mjs && node --check scripts/context/verify-api-routing.mjs && node --check tests/context/context.test.mjs",
    "context:test": "node --test tests/context/context.test.mjs",
    "docs:lint": "node scripts/docs/verify-docs.mjs",
    "docs:test": "node --test tests/docs/docs.test.mjs",
    "docs:sync-permissions": "node scripts/docs/sync-permission-diagrams.mjs",
    "docs:sync-metadata": "node scripts/docs/docs-metadata.mjs",
    "contracts:test": "node --test tests/contracts/contract-schemas.test.mjs tests/contracts/handoff-bytes.test.mjs",
    "contracts:storage:test": "node --test tests/storage/handoff-receipt-integration.test.mjs",
    "dev:web": "npm run dev --workspace @sacw/web",
    "dev:workspace": "npm run dev --workspace @sacw/workspace",
    "dev:knowledge": "npm run dev --workspace @sacw/knowledge",
    "dev:prototype": "npm start --workspace @sacw/prototype",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:session:storage": "node --test --test-concurrency=1 tests/workspace/persistence.test.mjs",
    "test:foundation": "npm run test --workspace @sacw/web && npm run test --workspace @sacw/workspace && npm run test --workspace @sacw/knowledge",
    "test:prototype": "npm test --workspace @sacw/prototype",
    "test:session:ui": "npm run build --workspace @sacw/web && node --test --test-concurrency=1 tests/workspace/ui.test.mjs",
    "test:session:lifecycle": "npm run build --workspace @sacw/workspace && node --test --test-concurrency=1 tests/workspace/lifecycle.test.mjs",
    "test:session:http": "npm run build --workspace @sacw/workspace && node --test --test-concurrency=1 tests/workspace/http.test.mjs",
    "test:projects": "node --test --test-concurrency=1 tests/workspace/project-authority.test.mjs tests/workspace/project-outcomes.test.mjs tests/workspace/project-http.test.mjs tests/workspace/project-cursor.test.mjs tests/workspace/project-reads.test.mjs tests/workspace/membership-lifecycle.test.mjs tests/workspace/membership-removal.test.mjs tests/workspace/project-concurrency.test.mjs tests/workspace/project-ui-controller.test.mjs tests/workspace/project-ui.test.mjs",
    "test:projects:browser": "node --test tests/workspace/project-browser.test.mjs"
  },
  "description": "Context/storage harness, synthetic prototype, session and bounded project/membership handlers with live UI; later business slices remain unimplemented.",
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.0",
    "jsdom": "26.1.0",
    "mermaid": "11.17.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "workspaces": [
    "apps/web",
    "services/workspace",
    "services/knowledge",
    "design/prototype"
  ]
}
