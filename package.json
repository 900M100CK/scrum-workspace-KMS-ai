{
  "name": "scrum-workspace-kms-context",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "node scripts/database.mjs init",
    "db:up": "node scripts/database.mjs up",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:rollback": "node scripts/database.mjs rollback",
    "db:stop": "node scripts/database.mjs stop",
    "db:test": "node --test --test-concurrency=1 tests/storage.test.mjs tests/storage/handoff-storage.test.mjs",
    "context:check": "node scripts/verify-context.mjs",
    "context:lint": "node --check scripts/verify-context.mjs && node --check scripts/context/verify-api-routing.mjs && node --check tests/context/context.test.mjs",
    "context:test": "node --test tests/context/context.test.mjs",
    "docs:lint": "node scripts/docs/verify-docs.mjs",
    "docs:test": "node --test tests/docs/docs.test.mjs",
    "docs:sync-permissions": "node scripts/docs/sync-permission-diagrams.mjs",
    "docs:sync-metadata": "node scripts/docs/docs-metadata.mjs",
    "contracts:test": "node --test tests/contracts/contract-schemas.test.mjs tests/contracts/handoff-bytes.test.mjs",
    "contracts:storage:test": "node --test tests/storage/handoff-receipt-integration.test.mjs"
  },
  "description": "Specification/contract harness and PostgreSQL storage foundation; application handlers are not implemented.",
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.0",
    "jsdom": "26.1.0",
    "mermaid": "11.17.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
