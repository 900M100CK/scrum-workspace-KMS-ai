{
  "name": "scrum-workspace-kms-context",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "node scripts/database.mjs init",
    "db:up": "node scripts/database.mjs up",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:rollback": "node scripts/database.mjs rollback",
    "db:stop": "node scripts/database.mjs stop",
    "db:test": "node --test tests/storage.test.mjs",
    "context:check": "node scripts/verify-context.mjs",
    "context:lint": "node --check scripts/verify-context.mjs && node --check tests/context.test.mjs",
    "context:test": "node --test tests/context.test.mjs",
    "docs:lint": "node scripts/verify-docs.mjs",
    "docs:test": "node --test tests/docs.test.mjs",
    "docs:sync-permissions": "node scripts/sync-permission-diagrams.mjs",
    "docs:sync-metadata": "node scripts/docs-metadata.mjs"
  },
  "description": "Specification/contract harness and PostgreSQL storage foundation; application handlers are not implemented.",
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "elkjs": "0.12.0",
    "jsdom": "26.1.0",
    "mermaid": "11.17.2"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
