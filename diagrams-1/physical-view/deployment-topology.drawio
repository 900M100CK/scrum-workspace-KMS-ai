      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;DGM-PHYS-01 v1.0 | Physical View: Deployment Topology &amp; Network Trust Boundaries&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#555;'&gt;Sources: SAD-03 §5; Single Developer Workstation, Isolated Databases, Local Ports, 4 Trust Boundaries&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1800" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="host_node" value="&lt;b&gt;Host Environment: Developer Workstation (Single Node)&lt;/b&gt;&lt;br/&gt;Node.js 24+ LTS, Linux/macOS/Windows, candidate 4 CPU cores / 8 GB RAM" style="swimlane;startSize=30;fillColor=#f8f9fa;strokeColor=#4a5568;strokeWidth=1.5;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="1300" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="node_browser" value="&lt;b&gt;Web Browser (Client)&lt;/b&gt;&lt;br/&gt;https://localhost:8000&lt;br/&gt;Same-Origin Presentation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="host_node">
          <mxGeometry x="50" y="60" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node_ws" value="&lt;b&gt;Workspace Service Process&lt;/b&gt;&lt;br/&gt;Port 8000 (HTTP/HTTPS Gateway)&lt;br/&gt;Gateway, Scrum Domain, Auth Policy, Relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="host_node">
