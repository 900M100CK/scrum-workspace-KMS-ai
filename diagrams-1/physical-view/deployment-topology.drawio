        </mxCell>
        <mxCell id="node_kn" value="&lt;b&gt;Knowledge Service Process&lt;/b&gt;&lt;br/&gt;Port 8001 (Internal Loopback Only)&lt;br/&gt;Document Store, Independent keyword / semantic search, Citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="host_node">
          <mxGeometry x="900" y="60" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="node_pg" value="&lt;b&gt;PostgreSQL 17.10 Instance (Port 5432)&lt;/b&gt;&lt;br/&gt;pgvector 0.8.2, dedicated UNIX socket / TCP loopback" style="swimlane;startSize=26;fillColor=#e8f5e9;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="host_node">
