<?xml version="1.0" ?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="DGM-DEV-01" name="package-layering">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;DGM-DEV-01 v1.0 | Development View: Monorepo Structure &amp; Layering Invariants&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#555;'&gt;Sources: SAD-03 §4, AGENTS.md; Module Layering, Zero Cross-DB Writes, Dependency-Free Harness&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1800" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_web" value="&lt;b&gt;apps/web/&lt;/b&gt;&lt;br/&gt;• User-facing React + Vite candidate (unselected) frontend&lt;br/&gt;• UI components, forms, client routing&lt;br/&gt;• Displays citations &amp;amp; failure banners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_contracts" value="&lt;b&gt;contracts/&lt;/b&gt; (Shared Interfaces)&lt;br/&gt;• &lt;code&gt;openapi/workspace.openapi.json&lt;/code&gt; (OpenAPI 3.1.1)&lt;br/&gt;• &lt;code&gt;openapi/knowledge.openapi.json&lt;/code&gt; (OpenAPI 3.1.1)&lt;br/&gt;• &lt;code&gt;data-model.json&lt;/code&gt; (Logical Data Schemas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_ws" value="&lt;b&gt;services/workspace/&lt;/b&gt; (Node.js 24+)&lt;br/&gt;• &lt;code&gt;src/auth/&lt;/code&gt;: Session &amp;amp; CSRF management&lt;br/&gt;• &lt;code&gt;src/scrum/&lt;/code&gt;: Backlog, Sprint, Task, Blocker&lt;br/&gt;• &lt;code&gt;src/policy/&lt;/code&gt;: Authoritative ACL Registry&lt;br/&gt;• &lt;code&gt;src/relay/&lt;/code&gt;: ADR-0006 Provider Relay Mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="240" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_kn" value="&lt;b&gt;services/knowledge/&lt;/b&gt; (Node.js 24+)&lt;br/&gt;• &lt;code&gt;src/documents/&lt;/code&gt;: Versions, passages, lifecycle&lt;br/&gt;• &lt;code&gt;src/retrieval/&lt;/code&gt;: Independent English FTS and pgvector exact&lt;br/&gt;• &lt;code&gt;src/synthesis/&lt;/code&gt;: Evidence check &amp;amp; citation engine&lt;br/&gt;• &lt;code&gt;src/audit/&lt;/code&gt;: Provenance &amp;amp; knowledge audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="240" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_infra" value="&lt;b&gt;infra/postgres/&lt;/b&gt; (PostgreSQL 17.10 + pgvector)&lt;br/&gt;• &lt;code&gt;init/&lt;/code&gt;: Separate database initialization&lt;br/&gt;• &lt;code&gt;migrations/&lt;/code&gt;: Isolated DDL per service&lt;br/&gt;• Runbook &amp;amp; test harness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="240" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_specs" value="&lt;b&gt;specs/&lt;/b&gt; (Bounded Implementation Slices)&lt;br/&gt;• SP-01 to SP-13: Explicit scopes &amp;amp; allowed paths&lt;br/&gt;• Trace to FR/BR/AC; planned unit/contract tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="410" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_eval" value="&lt;b&gt;eval/&lt;/b&gt; (Evaluation Fixtures)&lt;br/&gt;• 25 synthetic reference questions&lt;br/&gt;• Claim-support rubric &amp;amp; pilot test cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="410" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pkg_harness" value="&lt;b&gt;scripts/ &amp;amp; tests/&lt;/b&gt; (Context Harness)&lt;br/&gt;• &lt;code&gt;npm run context:lint&lt;/code&gt;: Syntax check&lt;br/&gt;• &lt;code&gt;npm run context:check&lt;/code&gt;: Contract shape check&lt;br/&gt;• &lt;code&gt;npm run context:test&lt;/code&gt;: Harness unit tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="410" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="inv_note" value="&lt;b&gt;Layering Invariants (SAD-03 §4.2):&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Domain Independence:&lt;/b&gt; Business domain logic has ZERO dependencies on UI or provider SDKs.&lt;br/&gt;2. &lt;b&gt;Zero Shared DB Writes:&lt;/b&gt; No shared library executes database writes. DB access is private to each service.&lt;br/&gt;3. &lt;b&gt;One-Way Dependency Flow:&lt;/b&gt; UI → Gateway contracts → Service contracts → Domain." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="540" width="740" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e_w_c" value="Depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="pkg_web" target="pkg_contracts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ws_c" value="Implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=7;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="pkg_ws" target="pkg_contracts">
