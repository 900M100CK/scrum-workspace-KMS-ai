classDiagram
    namespace WorkspaceContext {
        class User {
            +UUID user_id
            +String email
            +String display_name
            +Timestamp created_at
        }
        class Session {
            +String session_token
            +UUID user_id
            +Timestamp expires_at
            +String csrf_token
        }
        class Project {
            +UUID project_id
            +String name
            +String key
            +UUID owner_id
        }
        class ProjectMember {
            +UUID project_id
            +UUID user_id
            +String role
        }
        class Task {
            +UUID task_id
            +UUID project_id
            +UUID sprint_id
            +String state
            +Integer version
        }
        class Sprint {
            +UUID sprint_id
            +UUID project_id
            +String name
            +String status
        }
        class BlockerEvent {
            +UUID blocker_id
            +UUID task_id
            +String reason
        }
        class DocumentAclPolicy {
            +UUID document_id
            +UUID project_id
            +Enum classification
            +UUID[] explicit_grants
        }
    }

    namespace KnowledgeContext {
        class Document {
            +UUID document_id
            +UUID project_id
            +String title
            +UUID current_version_id
        }
        class DocumentVersion {
            +UUID version_id
            +UUID document_id
            +Integer version_number
            +Enum lifecycle_state
        }
        class DocumentPassage {
            +UUID passage_id
            +UUID version_id
            +Integer sequence_idx
            +Text text_content
        }
        class VectorEmbedding {
            +UUID embedding_id
            +UUID passage_id
            +vector embedding
        }
        class EvidenceManifest {
            +UUID manifest_id
            +UUID run_id
            +Tuple[] passages
        }
        class Citation {
            +UUID citation_id
            +UUID run_id
            +String display_label
        }
    }

    User "1" --> "*" Session
    Project "1" --> "*" ProjectMember
    Project "1" --> "*" Task
    Sprint "1" --> "*" Task
    Task "1" --> "*" BlockerEvent

    Document "1" --> "*" DocumentVersion
    DocumentVersion "1" --> "*" DocumentPassage
    DocumentPassage "1" --> "1" VectorEmbedding
    EvidenceManifest "1" --> "*" Citation

    DocumentAclPolicy ..> Document : "Soft Reference (document_id)"
